# Скопируй этот файл в .env и впиши свои настоящие ключи.
# .env никогда не попадает в git (см. .gitignore) — ключи остаются только у тебя.

# Токен Telegram-бота — получен от @BotFather после /newbot
TELEGRAM_BOT_TOKEN=

# Ключ OpenAI — используется только для распознавания голоса (Whisper)
OPENAI_API_KEY=

# Ключ Anthropic (Claude) — используется для понимания смысла и принятия решений
ANTHROPIC_API_KEY=

# Telegram chat_id — только тебе бот должен отвечать (защита от чужих сообщений)
# Узнать свой chat_id можно, написав боту @userinfobot
ALLOWED_CHAT_ID=

# Папка памяти Claude Code — та же самая, что синкается через Google Drive
# (junction на Windows / symlink на Mac указывает на неё). Путь разный на
# каждой машине, поэтому берём его из .env, а не зашиваем в код.
# Windows пример: C:\Users\chepk\.claude\projects\c--Users-chepk-workspace-mcp\memory
# Mac пример:     /Users/chepk/.claude/projects/<project-id>/memory
CLAUDE_MEMORY_DIR=

# Имя Gmail-метки для срочной почты (алерты каждые 30 мин, 07:30-22:30).
# Не обязательно — по умолчанию "Urgent". Заполняй, только если назвал метку
# в Gmail иначе.
URGENT_LABEL_NAME=
